# Command settings. In Vercel these live under Settings, then Environment Variables.
# For local development, copy this file to .env.local and fill it in.

# ---- Required ----
# Your Command sign-in password. Choose your own.
COMMAND_PASSWORD=choose-a-strong-password
# Long random text that keeps you signed in. Any 40+ random characters.
COMMAND_SESSION_SECRET=generate-a-long-random-secret
# Long random text that protects the scheduled jobs. Vercel sends it to them.
CRON_SECRET=generate-another-long-random-secret
# Your time zone, for example America/Chicago. Setup saves it too.
COMMAND_TIME_ZONE=America/New_York
# The AI key. Free to start at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- Added for you when you connect Supabase in Vercel (Storage tab) ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Lets Command build its own tables on first run.
POSTGRES_URL_NON_POOLING=postgres://...

# ---- Gmail and Calendar (one Google connection; Setup walks you through it) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ---- Optional ----
# Web search for the Funding Scout and Know it news. https://serper.dev
SERPER_API_KEY=
# Morning brief email. https://resend.com
RESEND_API_KEY=
# Send the brief from your own verified domain, for example: Assistant <brief@yourcompany.com>
RESEND_FROM_EMAIL=
# Cheapest Gemini models are the default. Change only if you want a different one.
GEMINI_FAST_MODEL=
GEMINI_WRITE_MODEL=
