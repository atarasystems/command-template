{
  "crons": [
    {
      "path": "/api/cron/email-triage",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/funding",
      "schedule": "30 12 * * *"
    },
    {
      "path": "/api/cron/reviews",
      "schedule": "45 21 * * *"
    },
    {
      "path": "/api/cron/linkedin-week",
      "schedule": "0 21 * * 5"
    },
    {
      "path": "/api/cron/know-news",
      "schedule": "5 11 * * *"
    }
  ],
  "functions": {
    "api/router.js": {
      "maxDuration": 300,
      "includeFiles": "supabase/schema/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path((?!router$).*)",
      "destination": "/api/router?__route=:path"
    }
  ]
}
